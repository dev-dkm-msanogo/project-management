# Serveur
# Port de l'API : API_PORT l'emporte sur PORT (que certains outils imposent à tout le processus).
API_PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Sécurité
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Persistance
# Si DATABASE_URL est défini → PostgreSQL ; sinon repli en mémoire (données volatiles).
# Lancer la base : docker compose up -d  (port hôte 5433)
DATABASE_URL=postgres://gdp:gdp@localhost:5433/gdp

# Authentification
# Générer un secret fort : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OBLIGATOIRE en production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
